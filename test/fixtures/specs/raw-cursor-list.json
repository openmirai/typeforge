{
  "openapi": "3.0.0",
  "info": { "title": "Orbit Artifacts API", "version": "1.0.0" },
  "paths": {
    "/api/orbit/v1/artifacts": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "records": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": { "code": { "type": "string" } }
                      }
                    },
                    "next_marker": { "type": "string", "nullable": true }
                  },
                  "required": ["records"]
                }
              }
            }
          }
        }
      }
    },
    "/api/orbit/v1/artifacts/{token}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string" },
                    "caption": { "type": "string" }
                  },
                  "required": ["code"]
                }
              }
            }
          }
        }
      }
    }
  }
}
