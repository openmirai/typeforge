{
  "openapi": "3.0.0",
  "info": { "title": "Acme Phase Mutations", "version": "3.0.0" },
  "paths": {
    "/api/acme/v3/widgets/{phase}": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "phase",
            "required": true,
            "schema": { "type": "string", "enum": ["alpha", "beta"] }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "title": { "type": "string" } },
                "required": ["title"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": { "code": { "type": "string" } }
                    },
                    "timestamp": { "type": "string" }
                  },
                  "required": ["success", "timestamp"]
                }
              }
            }
          }
        }
      },
      "patch": {
        "parameters": [
          {
            "in": "path",
            "name": "phase",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "title": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": { "code": { "type": "string" } }
                    },
                    "timestamp": { "type": "string" }
                  },
                  "required": ["success", "timestamp"]
                }
              }
            }
          }
        }
      }
    }
  }
}
